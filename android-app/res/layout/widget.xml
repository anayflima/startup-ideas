<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="12dp" android:background="@drawable/wbg">
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/w_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAVOOT HOURS" android:textSize="11sp" android:textStyle="bold" android:textColor="#24bdbb" />
    <TextView android:id="@+id/w_topic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not tracking" android:textSize="15sp" android:textStyle="bold" android:textColor="#ffffff" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp" />
    <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="#ffffff" android:visibility="gone" />
    <Chronometer android:id="@+id/w_todayc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#b3ffffff" android:visibility="gone" />
    <TextView android:id="@+id/w_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#99ffffff" />
    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="Start" android:textSize="13sp" android:textStyle="bold" android:textColor="#24bdbb" android:background="@drawable/pill_teal" android:maxLines="1" android:ellipsize="end" android:paddingLeft="8dp" android:paddingRight="8dp" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="10dp">
    <TextView android:id="@+id/w_sl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SWITCH TO" android:textSize="10sp" android:textStyle="bold" android:textColor="#80ffffff" />
    <TextView android:id="@+id/w_s1" style="@style/Pill" />
    <TextView android:id="@+id/w_s2" style="@style/Pill" />
    <TextView android:id="@+id/w_s3" style="@style/Pill" />
  </LinearLayout>
</LinearLayout>
